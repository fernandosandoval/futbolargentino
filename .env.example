# Los partidos se consultan desde la API pública de ESPN.
# No se requiere API key.

# Resend (https://resend.com/)
RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=Liga Profesional de Futbol Argentino <notificaciones@tudominio.com>
NOTIFICATION_EMAIL=destinatario@ejemplo.com

# Servidor (Render asigna PORT automáticamente)
PORT=3000

# Live tracking (opcional)
LIVE_POLL_INTERVAL_MS=60000

# Persistencia de jobs (opcional)
JOB_STORE_PATH=data/jobs.json
